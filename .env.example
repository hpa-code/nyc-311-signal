# Copy to .env for local runs. Never commit real values.
# Deployed code reads secrets from AWS Secrets Manager, not from this file.

AWS_REGION=us-east-2
AWS_PROFILE=

# Environment prefix: dev or prod
NYC311_ENV=dev
NYC311_BUCKET=

# Secrets Manager secret names (values live in Secrets Manager)
NYC311_SOCRATA_SECRET_NAME=dev/nyc311/socrata-app-token
NYC311_SNOWFLAKE_SECRET_NAME=dev/nyc311/snowflake-service-user

# Local-only fallbacks for development
SOCRATA_APP_TOKEN=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_DATABASE=NYC311_DEV
